model RentalOrder {
    id         String       @id @default(uuid())
    totalPrice Int
    status     RentalStatus @default(PENDING)
    startDate  DateTime 
    endDate    DateTime
    customerId String 
    customer User @relation(fields: [customerId],references: [id])
    items RentalOrderItems[]   
    payment Payment?   
    createdAt  DateTime     @default(now())
    updatedAt  DateTime     @updatedAt

    @@map("rental_orders")
}
