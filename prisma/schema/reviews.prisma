model Review {
  id        String   @id @default(uuid())
  rating    Int      
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  gearId    String
  gearItem  GearItem @relation(fields: [gearId], references: [id], onDelete: Cascade)

  rentalId  String     @unique 
  rental    RentalOrder @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@map("reviews")
}